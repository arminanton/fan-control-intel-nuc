<Window x:Class="NucFanControlGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel NUC Skull Canyon Hyper-Control Suite" Height="680" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#090D16" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CyberCard" TargetType="Border">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Telemetry Cards (4 cols) -->
            <RowDefinition Height="Auto"/> <!-- Cooling Section -->
            <RowDefinition Height="Auto"/> <!-- Power Section -->
            <RowDefinition Height="Auto"/> <!-- Persistence Section -->
            <RowDefinition Height="*"/>    <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Center">
            <TextBlock Text="⚡ INTEL NUC SKULL CANYON CONTROL" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="NUC6i7KYK • Nuvoton NCT5577D • Core i7-6770HQ • Iris Pro 580 (128MB eDRAM)" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Telemetry Cards Row (4 cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: CPU Temp -->
            <Border Grid.Column="0" Style="{StaticResource CyberCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CPU TEMP" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCpuTemp" Text="0.0°C" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtCoreTemp" Text="Core: 0°C" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Fan Speed -->
            <Border Grid.Column="2" Style="{StaticResource CyberCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FAN SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFanRpm" Text="0 RPM" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtDuty" Text="Duty: 0%" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Package Power -->
            <Border Grid.Column="4" Style="{StaticResource CyberCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PKG POWER" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtWatts" Text="0.0 W" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtPlLimits" Text="PL1: 45W" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: CPU Clock -->
            <Border Grid.Column="6" Style="{StaticResource CyberCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CPU CLOCK" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtClock" Text="0 MHz" FontSize="20" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtMode" Text="Mode: N/A" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cooling Section -->
        <Border Grid.Row="2" Style="{StaticResource CyberCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="COOLING CONTROLS &amp; FAN OVER-ROTATION" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnMax" Grid.Column="0" Height="36" Background="#EF4444" Click="BtnMax_Click">
                        <TextBlock Text="🚀 MAXIMUM OVER-ROTATE (100%)" FontSize="11" FontWeight="Bold"/>
                    </Button>

                    <Button x:Name="BtnAuto" Grid.Column="2" Height="36" Background="#10B981" Click="BtnAuto_Click">
                        <TextBlock Text="⚙ BIOS AUTO (SmartFan IV)" FontSize="11" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Button Style="{StaticResource PresetChip}" Content="50% Quiet" Click="FanPreset_Click" Tag="50"/>
                    <Button Style="{StaticResource PresetChip}" Content="70% Cool" Click="FanPreset_Click" Tag="70"/>
                    <Button Style="{StaticResource PresetChip}" Content="85% Heavy" Click="FanPreset_Click" Tag="85"/>
                    <Button Style="{StaticResource PresetChip}" Content="95% Extreme" Click="FanPreset_Click" Tag="95"/>
                </UniformGrid>

                <Grid Margin="0,2,0,0">
                    <TextBlock Text="Manual Fan Speed Slider" FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtSliderVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderPwm" Minimum="10" Maximum="100" Value="100" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPwm_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- Power Section (MSR 0x610) -->
        <Border Grid.Row="3" Style="{StaticResource CyberCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PACKAGE POWER BUDGET (RAPL MSR 0x610)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>

                <UniformGrid Columns="4" Margin="0,0,0,8">
                    <Button Style="{StaticResource PresetChip}" Content="ECO 35W" Click="PowerPreset_Click" Tag="35"/>
                    <Button Style="{StaticResource PresetChip}" Content="STOCK 45W" Click="PowerPreset_Click" Tag="45"/>
                    <Button Style="{StaticResource PresetChip}" Content="TURBO 55W" Click="PowerPreset_Click" Tag="55"/>
                    <Button Style="{StaticResource PresetChip}" Content="OVERCLOCK 65W" Click="PowerPreset_Click" Tag="65"/>
                </UniformGrid>

                <Grid Margin="0,2,0,0">
                    <TextBlock Text="PL1 Sustained Limit" FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtPl1Val" Text="50W" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderPl1" Minimum="25" Maximum="65" Value="50" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPl1_ValueChanged"/>

                <Grid Margin="0,6,0,0">
                    <TextBlock Text="PL2 Turbo Burst Limit" FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtPl2Val" Text="60W" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderPl2" Minimum="35" Maximum="75" Value="60" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPl2_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- Persistence & Startup -->
        <Border Grid.Row="4" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="STARTUP &amp; PERSISTENCE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <CheckBox x:Name="ChkBootMax" Foreground="#E2E8F0" FontSize="11" Checked="ChkBootMax_Changed" Unchecked="ChkBootMax_Changed">
                    <TextBlock Text="Keep 100% MAXIMUM fan speed on Windows boot and user logon" FontWeight="SemiBold"/>
                </CheckBox>
                <TextBlock Text="Forces full cooling over-rotation immediately when computer powers on." FontSize="9" Foreground="#64748B" Margin="22,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" VerticalAlignment="Bottom">
            <TextBlock x:Name="TxtBoardTemps" Text="Board: SYSTIN 0°C | AUXTIN 0°C | eDRAM: 128MB L4 Active" FontSize="9" Foreground="#64748B"/>
            <TextBlock Text="PawnIO Ring-0 Active" FontSize="9" Foreground="#10B981" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
