<Window x:Class="NucFanControlGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel NUC Skull Canyon Hyper-Control Suite" Height="730" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#090D16" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CyberCard" TargetType="Border">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#334155" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="2,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBlock Text="⚡ INTEL NUC SKULL CANYON CONTROL SUITE" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="NUC6i7KYK • Nuvoton NCT5577D • Core i7-6770HQ • Iris Pro 580 (128MB eDRAM)" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,4,0,10">
            <TabItem Header="❄️ COOLING &amp; SENSORS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="FAN TACHOMETER &amp; OVER-ROTATION (UP TO 7500 RPM)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU FAN SPEED" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtFanRpm" Text="0 RPM" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="FAN DUTY CYCLE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtDuty" Text="0%" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtMode" Text="Mode: N/A" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnMax" Grid.Column="0" Height="36" Background="#EF4444" Click="BtnMax_Click">
                                        <TextBlock Text="🚀 MAXIMUM OVER-ROTATE (7500 RPM)" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="BtnAuto" Grid.Column="2" Height="36" Background="#10B981" Click="BtnAuto_Click">
                                        <TextBlock Text="⚙ BIOS AUTO (SmartFan IV)" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Style="{StaticResource PresetChip}" Content="25% Quiet" Click="FanPreset_Click" Tag="25"/>
                                    <Button Style="{StaticResource PresetChip}" Content="50% Balanced" Click="FanPreset_Click" Tag="50"/>
                                    <Button Style="{StaticResource PresetChip}" Content="75% Heavy" Click="FanPreset_Click" Tag="75"/>
                                    <Button Style="{StaticResource PresetChip}" Content="100% Max" Click="FanPreset_Click" Tag="100"/>
                                </UniformGrid>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Manual Speed Slider (Banks 1, 2, 3 Synchronized)" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtSliderVal" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderPwm" Minimum="10" Maximum="100" Value="100" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPwm_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="AUTONOMOUS DYNAMIC FAN CURVE ENGINE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <CheckBox x:Name="ChkFanCurve" Content="Enable Autonomous Curve" FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Right" Checked="ChkFanCurve_Changed" Unchecked="ChkFanCurve_Changed"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Off / Minimum Speed Temperature" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtCurveOffVal" Text="40°C" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderCurveOff" Minimum="30" Maximum="50" Value="40" Margin="0,2,0,4" ValueChanged="SliderCurve_ValueChanged"/>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Ramp Up Transition Temperature" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtCurveRampVal" Text="55°C" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderCurveRamp" Minimum="45" Maximum="70" Value="55" Margin="0,2,0,4" ValueChanged="SliderCurve_ValueChanged"/>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="100% Full Tilt Temperature Threshold" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtCurveFullVal" Text="75°C" FontSize="10" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderCurveFull" Minimum="65" Maximum="85" Value="75" Margin="0,2,0,4" ValueChanged="SliderCurve_ValueChanged"/>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Baseline Minimum Duty Cycle" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtCurveMinDutyVal" Text="40%" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderCurveMinDuty" Minimum="25" Maximum="60" Value="40" Margin="0,2,0,0" ValueChanged="SliderCurve_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="QUAD-ZONE THERMAL SENSORS" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DIGITAL CORE" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCoreTemp" Text="0.0°C" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="SOCKET CPU" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCputin" Text="0.0°C" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="#1E293B" CornerRadius="6" Padding="6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BOARD SYS" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSystin" Text="0.0°C" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="6" Background="#1E293B" CornerRadius="6" Padding="6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="AUXILIARY" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAuxtin" Text="0.0°C" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <TextBlock Text="HARDWARE VOLTAGE RAIL MONITOR (NCT5577D)" FontSize="11" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtVcore" Text="VCORE: 0.000 V" FontSize="11" Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TxtVmem" Text="MEM VCC: 0.000 V" FontSize="11" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtAvcc" Text="AVCC: 0.000 V" FontSize="11" Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="Txt3vcc" Text="3VCC: 0.000 V" FontSize="11" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TxtVin4" Text="PCH CORE: 0.000 V" FontSize="11" Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="TxtVin6" Text="STANDBY: 0.000 V" FontSize="11" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚡ CPU &amp; POWER TUNING">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="REAL-TIME TELEMETRY &amp; TELEMETRIC METRICS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PACKAGE POWER" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtWatts" Text="0.0 W" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtPlSummary" Text="PL1: 50W | PL2: 60W" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="OPERATING CLOCK" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtClock" Text="0 MHz" FontSize="26" FontWeight="Bold" Foreground="#C084FC" Margin="0,2,0,0"/>
                                        <TextBlock Text="Base: 2600 MHz | Turbo: 3500 MHz" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="POWER BUDGET LIMITS (RAPL MSR 0x610)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Style="{StaticResource PresetChip}" Content="ECO 35W" Click="PowerPreset_Click" Tag="35"/>
                                    <Button Style="{StaticResource PresetChip}" Content="STOCK 45W" Click="PowerPreset_Click" Tag="45"/>
                                    <Button Style="{StaticResource PresetChip}" Content="TURBO 55W" Click="PowerPreset_Click" Tag="55"/>
                                    <Button Style="{StaticResource PresetChip}" Content="OVERCLOCK 65W" Click="PowerPreset_Click" Tag="65"/>
                                </UniformGrid>

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="PL1 Sustained Power Limit" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtPl1Val" Text="50W" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderPl1" Minimum="25" Maximum="65" Value="50" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPl1_ValueChanged"/>

                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="PL2 Short Duration Burst Limit" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtPl2Val" Text="60W" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderPl2" Minimum="35" Maximum="75" Value="60" SmallChange="1" LargeChange="5" Margin="0,4,0,0" ValueChanged="SliderPl2_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CORE MULTIPLIER &amp; UNCORE FREQUENCY MATRIX (MSR 0x1AD / 0x620)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="1-CORE" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRatio1C" Text="35x" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="3500 MHz" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="2-CORES" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRatio2C" Text="34x" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="3400 MHz" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="3-CORES" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRatio3C" Text="33x" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="3300 MHz" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="6" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="4-CORES" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRatio4C" Text="32x" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="3200 MHz" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtUncoreSpecs" Text="Ring / Uncore Frequency: 800 MHz to 3500 MHz | TjMax: 100°C" FontSize="10" Foreground="#94A3B8" Margin="2,4,0,0"/>
                                <TextBlock x:Name="TxtLockSpecs" Text="Silicon Status: CFG Lock UNLOCKED | MSR 0xCE OC Flag ACTIVE" FontSize="10" Foreground="#10B981" Margin="2,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <TextBlock Text="HARDWARE SAFETY &amp; VALIDATION ENGINE" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Thermal Watchdog Guardrail" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        <TextBlock Text="Automatic fallback to stock 45W if core exceeds 85°C." FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="8,4,8,4">
                                        <TextBlock x:Name="TxtWatchdogStatus" Text="GUARD ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                </Grid>

                                <Button x:Name="BtnStressTest" Height="34" Background="#3B82F6" Click="BtnStressTest_Click" Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtStressLabel" Text="⚡ RUN 15-SECOND HARDWARE STABILITY TEST" FontSize="11" FontWeight="Bold"/>
                                </Button>
                                <ProgressBar x:Name="ProgStress" Height="4" Margin="0,6,0,0" Foreground="#3B82F6" Background="#1E293B" Value="0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🎮 IRIS PRO GRAPHICS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="INTEL IRIS PRO GRAPHICS 580 (GT4e)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EXECUTION UNITS: 72 EUs (576 Shaders)" FontSize="11" Foreground="#E2E8F0"/>
                                        <TextBlock Text="BASE CLOCK: 350 MHz" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        <TextBlock Text="MAX TURBO: 950 MHz" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="eDRAM: 128 MB ON-PACKAGE" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="L4 CACHE: ~50 GB/s BANDWIDTH" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                        <TextBlock Text="DIRECT DIE INTEGRATION" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="iGPU PERFORMANCE &amp; POWER POLICY (MSR 0x642)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="iGPU REAL-TIME POWER" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtGpuWatts" Text="0.0 W" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ENERGY PREFERENCE" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="TxtGpuPolicy" Text="Policy: 13 (Balanced)" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <Button Style="{StaticResource PresetChip}" Content="🚀 MAX GAMING/AI (0)" Click="GpuPolicy_Click" Tag="0"/>
                                    <Button Style="{StaticResource PresetChip}" Content="⚖ BALANCED (13)" Click="GpuPolicy_Click" Tag="13"/>
                                    <Button Style="{StaticResource PresetChip}" Content="🌱 ECO SAVER (24)" Click="GpuPolicy_Click" Tag="24"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SHARED VRAM &amp; DVMT APERTURE" FontSize="11" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,8"/>
                                <TextBlock Text="System Memory: 32 GB Dual-Channel DDR4 installed" FontSize="11" Foreground="#E2E8F0"/>
