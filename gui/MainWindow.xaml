<Window x:Class="NucFanControlGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel NUC Fan Controller (Skull Canyon)" Height="580" Width="470"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#18181B" Foreground="#E4E4E7" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Cards -->
            <RowDefinition Height="Auto"/> <!-- Big Buttons -->
            <RowDefinition Height="Auto"/> <!-- Quick Presets -->
            <RowDefinition Height="Auto"/> <!-- Slider -->
            <RowDefinition Height="Auto"/> <!-- Persistence -->
            <RowDefinition Height="*"/>    <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="⚡ Intel NUC Fan Controller" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="NUC6i7KYK • Nuvoton NCT5577D / NCT6776F Super I/O" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Telemetry Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Temp -->
            <Border Grid.Column="0" Background="#27272A" CornerRadius="8" Padding="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CPU TEMP" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCpuTemp" Text="--.-°C" FontSize="24" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: RPM -->
            <Border Grid.Column="2" Background="#27272A" CornerRadius="8" Padding="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FAN SPEED" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFanRpm" Text="---- RPM" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Duty -->
            <Border Grid.Column="4" Background="#27272A" CornerRadius="8" Padding="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="DUTY CYCLE" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtDuty" Text="--%" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtMode" Text="Mode: --" FontSize="10" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Big Buttons Row -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnMax" Grid.Column="0" Height="42" Background="#DC2626" Click="BtnMax_Click">
                <TextBlock Text="🚀 MAXIMUM (100% Full Tilt)" FontSize="13" FontWeight="Bold"/>
            </Button>

            <Button x:Name="BtnAuto" Grid.Column="2" Height="42" Background="#16A34A" Click="BtnAuto_Click">
                <TextBlock Text="⚙ BIOS Auto (SmartFan)" FontSize="13" FontWeight="Bold"/>
            </Button>
        </Grid>

        <!-- Quick Presets -->
        <Border Grid.Row="3" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="QUICK COOLING PRESETS" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,8"/>
                <UniformGrid Columns="4">
                    <Button Height="30" Margin="2" Background="#3F3F46" Content="50% Quiet" Click="Preset_Click" Tag="50"/>
                    <Button Height="30" Margin="2" Background="#3F3F46" Content="70% Cool" Click="Preset_Click" Tag="70"/>
                    <Button Height="30" Margin="2" Background="#3F3F46" Content="85% Heavy" Click="Preset_Click" Tag="85"/>
                    <Button Height="30" Margin="2" Background="#3F3F46" Content="95% Extreme" Click="Preset_Click" Tag="95"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Slider -->
        <Border Grid.Row="4" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <TextBlock Text="MANUAL FAN SPEED" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                    <TextBlock x:Name="TxtSliderVal" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderPwm" Minimum="10" Maximum="100" Value="100" SmallChange="1" LargeChange="5" Margin="0,8,0,0" ValueChanged="SliderPwm_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- Persistence & Startup -->
        <Border Grid.Row="5" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SYSTEM STARTUP &amp; PERSISTENCE" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkBootMax" Foreground="#E4E4E7" FontSize="12" Checked="ChkBootMax_Changed" Unchecked="ChkBootMax_Changed">
                    <TextBlock Text="Keep 100% MAXIMUM fan speed on Windows boot and user logon" FontWeight="SemiBold"/>
                </CheckBox>
                <TextBlock Text="Automatically applies 100% fan over-rotation at startup via Task Scheduler." FontSize="10" Foreground="#71717A" Margin="22,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="6" VerticalAlignment="Bottom">
            <TextBlock x:Name="TxtBoardTemps" Text="Board: SYSTIN 0°C | AUXTIN 0°C" FontSize="10" Foreground="#71717A"/>
            <TextBlock Text="PawnIO Ring-0 Driver Active" FontSize="10" Foreground="#22C55E" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
